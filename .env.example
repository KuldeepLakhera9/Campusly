# CAMPUSLY Environment Configuration
# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusly?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campusly

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Secrets (Phase 2)
AUTH_SECRET=campusly_development_secret_key_change_in_production
